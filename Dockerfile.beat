# =============================================================================
# Hotel Backend - Celery Beat Dockerfile
# =============================================================================
# This Dockerfile is used for the Celery Beat scheduler service
# =============================================================================

FROM python:3.14-slim

# Environment variables for Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies directly
RUN pip install --no-cache-dir \
    django>=6.0.1 \
    djangorestframework \
    djangorestframework-simplejwt \
    celery \
    redis \
    django-celery-beat \
    django-celery-results \
    drf-spectacular>=0.29.0 \
    django-cors-headers>=4.9.0 \
    "psycopg[binary]" \
    pytz>=2024.2

# Copy application code
COPY . /app

# Copy and set permissions for entrypoint script
COPY entrypoint-beat.sh /app/entrypoint-beat.sh
RUN chmod +x /app/entrypoint-beat.sh

# Set working directory to src for Celery
WORKDIR /app/src

# Run entrypoint script (waits for DB then starts beat)
CMD ["/app/entrypoint-beat.sh"]
