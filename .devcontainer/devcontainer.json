// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	"image": "mcr.microsoft.com/devcontainers/python:2-3.14-trixie",
	"postCreateCommand": "uv sync && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash && export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm install 24 && nvm use 24 && nvm alias default 24",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.debugpy",
				"ms-python.vscode-pylance",
				"GitHub.copilot-chat"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.linting.enabled": true,
				"python.linting.pylintEnabled": true,
				"python.formatting.provider": "black"
			}
		}
	},
	"forwardPorts": [
		8000,
		5432,
		6379,
		3000
	],
	"portsAttributes": {
		"8000": {
			"label": "Django",
			"onAutoForward": "notify"
		},
		"5432": {
			"label": "PostgreSQL",
			"onAutoForward": "notify"
		},
		"6379": {
			"label": "Redis",
			"onAutoForward": "notify"
		},
		"3000": {
			"label": "Frontend",
			"onAutoForward": "notify"
		}
	},
	"remoteEnv": {
		"DB_HOST": "host.docker.internal",
		"REDIS_HOST": "host.docker.internal"
	},
	"runArgs": [
		"--add-host",
		"host.docker.internal:host-gateway"
	]
}